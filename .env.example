# MySQL Sakila source database
MYSQL_HOST=localhost
MYSQL_PORT=3306
# your credentials, for me it's root with an empty password.
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=sakila

# Separate MySQL database for automated tests
MYSQL_TEST_DATABASE=sakila_test

# SQLite analytics database
SQLITE_DATABASE_PATH=data/analytics.db

# Separate SQLite database for automated tests
SQLITE_TEST_DATABASE_PATH=data/analytics_test.db
